# Локальный git-репозиторий этой папки нужен только как «точка отката»:
# удалил что-то по ошибке — git checkout вернёт. Внешнего remote нет.
# Всё, что уходит на сервер, собирается из этой папки (см. README.md).

# Окружения и зависимости
.venv-web/
.venv-web-req.txt
frontend/node_modules/
frontend/dist/
__pycache__/
*.py[cod]

# Сборка фронтенда (создаётся npm run build)
web/static/

# Локальные тестовые данные, снимки базы, пароль превью
.webtest/
*.db
*.db-wal
*.db-shm

# Данные почтового бота (живут на томе Fly, тут — локальная копия-бэкап)
mailbot_data/

# Секреты
.env
.env.*
